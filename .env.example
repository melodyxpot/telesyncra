# Copy this file to .env and fill in your own values.
# Never commit .env, session files, or the SQLite database.

# From https://my.telegram.org → API development tools
TG_API_ID=12345678
TG_API_HASH=0123456789abcdef0123456789abcdef

# From @BotFather. This bot is only the control menu.
BOT_TOKEN=123456789:replace_with_your_bot_token

# Your numeric Telegram user id. Only this account can use the menu.
ALLOWED_USER_ID=1000000000

# Local files. These are created automatically and must stay private.
SESSION_PATH=./data/telesyncra.session
DATABASE_PATH=./data/telesyncra.db

# debug | info | warn | error
LOG_LEVEL=info
